{
  "name": "Openpolis",
  "short_name": "Openpolis",
  "description": "An open-world city simulation you play in your browser.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0e1820",
  "theme_color": "#0e1820",
  "icons": [
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "orientation": "any"
}
