# Copy to .env on the server (docs/deploy.md) and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me
# Public path when hosted under a subfolder, e.g. /Republic/.
VITE_PUBLIC_BASE=/
# Key for guest fingerprints (required): openssl rand -base64 48
GUEST_SECRET=
# Guest trial minutes (optional; defaults 10 and 30)
# GUEST_NUDGE_MINUTES=10
# GUEST_LIMIT_MINUTES=30
# Sign-up codes and password reset by email (Brevo; docs/deploy.md). Off when empty.
BREVO_API_KEY=
MAIL_FROM=noreply@openpolis.space
# MAIL_FROM_NAME=Openpolis
# MAIL_DAILY_LIMIT=250
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


