{
  "name": "openpolis",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bun run --parallel dev:web dev:server",
    "dev:web": "vite",
    "dev:server": "bun --watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "build:exe": "cmd /c Compilar.bat",
    "start": "NODE_ENV=production bun server/index.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim:run": "bun scripts/sim-run.ts",
    "bench": "bun run sim:run --scenario demo --years 1 --budget",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server && tsc --noEmit -p scripts",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "express": "^5.3.0",
    "jotai": "^3.0.1",
    "pg": "^8.23.1",
    "pixi.js": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
